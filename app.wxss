page {
  min-height: 100vh;
  background: #f6f8f5;
  color: #13231d;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", Arial, sans-serif;
  letter-spacing: 0;
}
view, text, button, input, textarea { box-sizing: border-box; }
button { padding: 0; margin: 0; background: transparent; border: 0; line-height: 1.2; }
button::after { border: 0; }
.screen { min-height: 100vh; padding: 0 28rpx 40rpx; }
.nav { padding: 92rpx 0 28rpx; display: flex; align-items: center; justify-content: space-between; }
.nav-title { font-size: 40rpx; font-weight: 700; color: #10231b; }
.nav-sub { margin-top: 8rpx; color: #6d7a70; font-size: 24rpx; }
.pill { display: inline-flex; align-items: center; min-height: 56rpx; padding: 0 22rpx; border-radius: 999rpx; background: rgba(255,255,255,.78); color: #2c5c49; font-size: 24rpx; box-shadow: 0 12rpx 36rpx rgba(34, 79, 58, .08); }
.panel { background: rgba(255,255,255,.9); border: 1rpx solid rgba(33, 75, 56, .08); border-radius: 24rpx; box-shadow: 0 18rpx 50rpx rgba(43, 79, 62, .08); }
.section-head { display: flex; align-items: center; justify-content: space-between; margin: 34rpx 0 18rpx; }
.section-title { font-size: 32rpx; font-weight: 700; }
.section-link { font-size: 24rpx; color: #2b7c5b; }
.grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 18rpx; }
.action { min-height: 148rpx; padding: 18rpx 8rpx; border-radius: 20rpx; background: #fff; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 14rpx; box-shadow: 0 10rpx 28rpx rgba(31, 70, 51, .06); }
.action-icon { width: 56rpx; height: 56rpx; border-radius: 18rpx; display: flex; align-items: center; justify-content: center; color: #fff; font-size: 28rpx; font-weight: 700; }
.action text { font-size: 24rpx; color: #21342d; }
.list { display: flex; flex-direction: column; gap: 18rpx; }
.row { padding: 26rpx; border-radius: 22rpx; background: #fff; display: flex; align-items: center; justify-content: space-between; box-shadow: 0 10rpx 28rpx rgba(31, 70, 51, .05); }
.row-main { min-width: 0; }
.row-title { font-size: 29rpx; font-weight: 650; color: #14261e; }
.row-desc { margin-top: 8rpx; color: #718071; font-size: 23rpx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 470rpx; }
.status { padding: 8rpx 16rpx; border-radius: 999rpx; font-size: 22rpx; color: #226046; background: #e7f4ed; }
.primary-btn { height: 88rpx; border-radius: 20rpx; background: #1f6f52; color: #fff; font-size: 30rpx; font-weight: 650; display: flex; align-items: center; justify-content: center; }
.secondary-btn { height: 76rpx; border-radius: 18rpx; background: #edf3ef; color: #255846; font-size: 28rpx; display: flex; align-items: center; justify-content: center; }
.input, .textarea { width: 100%; background: #fff; border: 1rpx solid #e1e8e3; border-radius: 18rpx; padding: 24rpx; font-size: 28rpx; color: #14261e; }
.textarea { min-height: 180rpx; }
.form { display: flex; flex-direction: column; gap: 22rpx; }
.label { color: #526257; font-size: 24rpx; margin-bottom: -10rpx; }
.safe-bottom { padding-bottom: env(safe-area-inset-bottom); }
