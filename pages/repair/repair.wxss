.chips { display: flex; flex-wrap: wrap; margin: -8rpx -8rpx 18rpx; }
.chip { width: calc(50% - 16rpx); margin: 8rpx; height: 76rpx; border-radius: 18rpx; background: #fff; color: #526257; font-size: 26rpx; display: flex; align-items: center; justify-content: center; }
.chip.on { background: #1f6f52; color: #fff; font-weight: 650; }
.upload { height: 188rpx; display: flex; align-items: center; justify-content: center; color: #718071; font-size: 28rpx; }
