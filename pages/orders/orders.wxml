<view class="screen">
  <view class="nav">
    <view>
      <view class="nav-title">我的工单</view>
      <view class="nav-sub">报修、缴费、访客与反馈进度</view>
    </view>
  </view>
  <view class="tabs panel">
    <button wx:for="{{tabs}}" wx:key="*this" class="tab {{active === index ? 'on' : ''}}" bindtap="setTab" data-index="{{index}}">{{item}}</button>
  </view>
  <view class="list order-list">
    <view class="row" wx:for="{{orders}}" wx:key="title">
      <view class="row-main">
        <view class="row-title">{{item.title}}</view>
        <view class="row-desc">{{item.desc}}</view>
      </view>
      <view class="status">{{item.status}}</view>
    </view>
  </view>
</view>

