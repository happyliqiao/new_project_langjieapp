<view class="screen visitor">
  <view class="nav"><view><view class="nav-title">访客通行</view><view class="nav-sub">临时通行码与车辆预约</view></view></view>
  <view class="code-card panel">
    <view class="code-title">访客码</view>
    <view class="code">{{code}}</view>
    <view class="nav-sub">有效期：{{expire}}</view>
  </view>
  <view class="form">
    <text class="label">访客姓名</text><input class="input" placeholder="请输入访客姓名" />
    <text class="label">手机号</text><input class="input" placeholder="用于门岗核验" />
    <text class="label">到访时间</text><input class="input" value="2026-06-08 18:00" />
    <button class="primary-btn" bindtap="create">生成通行码</button>
  </view>
</view>

